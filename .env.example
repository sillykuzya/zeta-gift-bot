# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Строка подключения к PostgreSQL
DB_DSN=postgresql://ryzen_user:ryzen_password@localhost:5432/ryzen

# ID группового чата модераторов (бот должен быть добавлен туда с правом удаления сообщений)
# Отрицательное число для групп/супергрупп, например -1001234567890
MODERATION_GROUP_ID=-1001234567890

# ID администраторов бота через запятую, без пробелов
ADMIN_IDS=111111111,222222222

# ID менеджера(ов), которые могут отмечать выдачу подарка командой /given
# (может отличаться от ADMIN_IDS — менеджеру не обязательно давать доступ к /admin)
MANAGER_IDS=333333333

# Юзернейм менеджера, который выдаёт подарки (без @) — используется в кнопке-ссылке
MANAGER_USERNAME=your_manager
